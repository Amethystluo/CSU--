page{background:#f4f7f4;color:#183744;font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei",sans-serif}.page{min-height:100vh;padding:40rpx 32rpx;box-sizing:border-box}.title{font-size:46rpx;font-weight:700;color:#146b55}.subtitle{font-size:26rpx;color:#6c7d75;margin-top:12rpx}.card{background:#fff;border-radius:24rpx;padding:34rpx;box-shadow:0 10rpx 35rpx rgba(24,58,40,.08);margin-top:34rpx}.primary{background:#167052;color:#fff;border:0;border-radius:18rpx;font-size:32rpx;padding:28rpx;margin-top:24rpx}.secondary{background:#fff;color:#167052;border:2rpx solid #9bcab0;border-radius:18rpx;font-size:32rpx;padding:26rpx;margin-top:22rpx}.tip{font-size:24rpx;color:#687a70;line-height:1.7}.section-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.back{color:#167052;font-size:28rpx;margin-bottom:20rpx}.map-wrap{position:relative;width:100%;height:calc(100vh - 250rpx);min-height:900rpx;overflow:hidden;background:#eef3ef}.map-img{width:100%;height:100%;display:block;object-fit:contain}.modebar{display:flex;background:#fff;padding:14rpx;border-radius:16rpx;margin-bottom:16rpx}.modebar button{flex:1;border:0;background:#fff;color:#547268}.modebar .active{color:#167052;font-weight:700;background:#e6f2ec;border-radius:12rpx}.stats{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.stat{background:#f2f8f4;border-radius:14rpx;padding:18rpx}.stat b{display:block;font-size:34rpx;color:#167052}.stat text{font-size:22rpx;color:#61736a}.route-map{position:relative;height:900rpx;background:#fff;border-radius:18rpx;overflow:hidden}.route-map canvas{position:absolute;inset:0;width:100%;height:100%}.picker{background:#fff;border:2rpx solid #c9ddd0;border-radius:14rpx;padding:20rpx;width:100%;box-sizing:border-box}
.route-zoom{position:absolute;inset:0;transform-origin:center center}.route-zoom .map-img{position:absolute;inset:0}.route-canvas{position:absolute;inset:0;width:100%;height:100%}.zoom-tools{position:absolute;right:18rpx;bottom:18rpx;display:flex;align-items:center;gap:8rpx;background:#ffffffdd;border-radius:14rpx;padding:8rpx}.zoom-tools button{min-width:62rpx;height:58rpx;line-height:58rpx;padding:0;color:#167052;background:#fff;border:1rpx solid #b9d8c5;border-radius:10rpx;font-size:28rpx}.zoom-tools text{min-width:58rpx;text-align:center;color:#167052;font-size:24rpx}
