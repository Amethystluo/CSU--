.index-bg{min-height:100vh;background:linear-gradient(180deg,#eaf5ef 0%,#f4f7f4 42%,#f9fbf9 100%);padding-bottom:60rpx}

/* ===== Hero 区 ===== */
.hero{background:linear-gradient(135deg,#146b55,#1f8a6f 68%,#2aa57f);color:#fff;padding:72rpx 48rpx 84rpx 48rpx;position:relative;overflow:hidden}
.hero::after{content:'';position:absolute;right:-80rpx;top:-60rpx;width:300rpx;height:300rpx;border-radius:50%;background:rgba(255,255,255,.09)}
.hero::before{content:'';position:absolute;right:60rpx;bottom:-90rpx;width:220rpx;height:220rpx;border-radius:50%;background:rgba(255,255,255,.06)}
.hero-badge{display:inline-block;font-size:22rpx;background:rgba(255,255,255,.18);padding:8rpx 22rpx;border-radius:999rpx;letter-spacing:2rpx}
.hero-title{font-size:52rpx;font-weight:800;margin-top:30rpx;letter-spacing:2rpx}
.hero-sub{font-size:26rpx;opacity:.92;margin-top:18rpx;letter-spacing:1rpx}

/* ===== 功能区 ===== */
.grid-section{position:relative;margin:-44rpx 24rpx 0 24rpx;background:#fff;border-radius:28rpx;box-shadow:0 18rpx 50rpx rgba(20,107,85,.12);padding:32rpx 28rpx;z-index:2}
.section-label{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:26rpx}
.section-title{font-size:32rpx;font-weight:700;color:#1b3b2e}
.section-hint{font-size:22rpx;color:#97a79d}
.nav-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20rpx}
.nav-tile{display:flex;flex-direction:column;align-items:center;padding:26rpx 12rpx;border-radius:22rpx;background:#f7faf8;transition:transform .1s ease}
.nav-tile:active{transform:scale(.96);background:#eef5f0}
.tile-icon{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;border-radius:26rpx;font-size:44rpx;margin-bottom:16rpx}
.tile-title{font-size:27rpx;font-weight:600;color:#1b3b2e}
.tile-sub{font-size:20rpx;color:#9aa9a0;margin-top:8rpx}

/* ===== 底部说明 ===== */
.foot-tip{margin:44rpx 44rpx 0 44rpx;padding:24rpx 28rpx;background:rgba(22,112,82,.06);border-radius:18rpx}
.foot-tip text{font-size:22rpx;color:#7d8f85;line-height:1.8}
