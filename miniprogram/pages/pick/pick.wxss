/* 全屏、不滚动：这是"点哪儿就是哪儿"的前提 */
page{height:100%;overflow:hidden}
.pick-page{display:flex;flex-direction:column;height:100vh;background:#eef3ef}

/* 顶部 */
.pick-top{display:flex;align-items:center;padding:18rpx 24rpx;background:#fff}
.pick-back{font-size:28rpx;color:#167052;padding-right:16rpx}
.pick-title{flex:1;font-size:31rpx;font-weight:700;color:#146b55;text-align:center}
.pick-zoom-tools{display:flex;align-items:center}
.pick-zoom-btn{width:56rpx;height:56rpx;line-height:56rpx;text-align:center;color:#167052;background:#f2f8f4;border:2rpx solid #c9ddd0;border-radius:10rpx;font-size:30rpx}
.pick-zoom-val{min-width:76rpx;text-align:center;font-size:22rpx;color:#167052}
.pick-hint{padding:16rpx 24rpx;font-size:23rpx;color:#5d6f66;background:#e6f2ec;line-height:1.5}
.pick-hint-sub{color:#167052}

/* 地图：占满剩余空间 */
.pick-map{position:relative;flex:1;overflow:hidden;background:#f8faf7}
.pick-zoom{position:absolute;left:0;top:0;right:0;bottom:0;transform-origin:center center}
.pick-img{position:absolute;left:0;top:0;right:0;bottom:0;width:100%;height:100%}
.pick-canvas{position:absolute;left:0;top:0;right:0;bottom:0;width:100%;height:100%}

/* 全览 / 复位 */
.pick-tools{position:absolute;right:18rpx;top:18rpx;display:flex;gap:10rpx}
.pick-tool{font-size:22rpx;color:#167052;background:#ffffffdd;border:2rpx solid #c9ddd0;border-radius:10rpx;padding:10rpx 18rpx}

.pick-legend{position:absolute;left:18rpx;bottom:18rpx;background:#ffffffdd;border-radius:12rpx;padding:12rpx 16rpx}
.pick-legend-bar{width:180rpx;height:14rpx;border-radius:7rpx;background:linear-gradient(90deg,#ffe648,#ff9d27,#d12626,#8f142c)}
.pick-legend-text{font-size:18rpx;color:#5d6f66;margin-top:4rpx}
.pick-legend-row{display:flex;align-items:center;margin-top:8rpx}
.pick-legend-dash{width:44rpx;height:0;border-top:4rpx dashed #3a3a3a;margin-right:8rpx}
.pick-legend-row text{font-size:18rpx;color:#5d6f66}

.pick-cross{position:absolute;left:18rpx;right:18rpx;top:18rpx;background:#ffffffef;border-left:8rpx solid #ff8a00;border-radius:12rpx;padding:14rpx 18rpx}
.pick-cross-title{font-size:25rpx;color:#1c3b31;font-weight:600}
.pick-cross-detail{font-size:21rpx;color:#718178;margin-top:6rpx}

/* 底部确认栏 */
.pick-bottom{background:#fff;padding:20rpx 24rpx 30rpx;box-shadow:0 -6rpx 24rpx rgba(24,58,40,.08)}
.pick-empty{font-size:24rpx;color:#8a9a92;text-align:center;padding:12rpx 0}
.pick-sel{font-size:26rpx;color:#146b55;font-weight:600;margin-bottom:14rpx}
.pick-actions{display:flex;gap:16rpx}
.mini{flex:1;margin:0;padding:20rpx 8rpx;font-size:27rpx;line-height:1.3;color:#167052;background:#f2f8f4;border:2rpx solid #c9ddd0;border-radius:16rpx;text-align:center}
.mini::after{border:none}
.mini-active{background:#167052;color:#fff;border-color:#167052}

/* 上报类型面板 */
.sheet-mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.35);z-index:20}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;background:#fff;border-radius:28rpx 28rpx 0 0;padding:32rpx 28rpx 40rpx}
.sheet-head{margin-bottom:22rpx}
.sheet-title{font-size:32rpx;font-weight:700;color:#146b55}
.sheet-loc{font-size:22rpx;color:#718178;margin-top:8rpx}
.sheet-cats{display:flex;flex-wrap:wrap;gap:14rpx}
.sheet-cat{width:calc(50% - 7rpx);box-sizing:border-box;border:2rpx solid #dbe8e1;border-radius:16rpx;padding:18rpx}
.sheet-cat-on{border-color:#167052;background:#e6f2ec}
.sheet-dot{width:44rpx;height:44rpx;line-height:44rpx;text-align:center;border-radius:50%;color:#fff;font-size:22rpx;font-weight:700}
.sheet-cat-name{font-size:26rpx;color:#1c3b31;margin-top:10rpx;font-weight:600}
.sheet-cat-hint{font-size:20rpx;color:#8a9a92;margin-top:4rpx}
.sheet-note{margin-top:22rpx;background:#f4f8f5;border-radius:14rpx;padding:20rpx;font-size:25rpx}
.sheet-tip{font-size:21rpx;color:#8a9a92;margin-top:16rpx;text-align:center}
