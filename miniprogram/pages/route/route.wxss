/* 起点 / 终点行 */
.row-head{display:flex;align-items:center;margin-bottom:14rpx}.row-title{font-size:28rpx;font-weight:600;color:#146b55}
.dot{width:18rpx;height:18rpx;border-radius:50%;margin-right:14rpx}
.dot-start{background:#167052}
.dot-dest{background:#d22626}
.badge{margin-left:14rpx;font-size:20rpx;color:#167052;background:#e6f2ec;border-radius:20rpx;padding:4rpx 14rpx}
.badge-warn{color:#8a4b00;background:#fff0d6}
.dim{color:#718178;font-size:24rpx}
.row-value{font-size:28rpx;line-height:1.5;word-break:break-all}

/* 当天事件（活动） */
.ev-row{display:flex;align-items:center;gap:14rpx;border-top:2rpx solid #eef3ef;padding-top:14rpx;margin-top:14rpx}
.ev-main{flex:1;min-width:0}
.ev-title{font-size:27rpx;font-weight:600;color:#1d3b31}
.ev-type{margin-left:10rpx;font-size:20rpx;font-weight:400;color:#718178;background:#f2f4f3;border-radius:8rpx;padding:2rpx 10rpx}
.ev-meta{font-size:22rpx;color:#4c6b5f;margin-top:6rpx;line-height:1.5}

/* 已封路段列表 */
.closed-item{display:flex;align-items:center;justify-content:space-between;background:#f4f4f4;border-left:8rpx solid #3a3a3a;border-radius:10rpx;padding:18rpx;margin-top:14rpx}
.closed-main{flex:1}
.closed-name{font-size:26rpx;font-weight:600;color:#2c2c2c}
.closed-meta{font-size:21rpx;color:#718178;margin-top:6rpx}
.closed-del{font-size:24rpx;color:#b3261e;padding:8rpx 20rpx;border:2rpx solid #f0c7c3;border-radius:12rpx}

/* 地图图例
 *
 * 想挪动它，**只改这一行**。四个角的写法（注意 top/bottom 只能留一个，
 * 同时写会让元素被撑开、看起来"怎么都动不了"）：
 *   左上： top:18rpx;    bottom:auto;   left:18rpx;   right:auto;
 *   右上： top:18rpx;    bottom:auto;   left:auto;    right:18rpx;
 *   左下： top:auto;     bottom:18rpx;  left:18rpx;   right:auto;
 *   右下： top:auto;     bottom:18rpx;  left:auto;    right:18rpx;
 * 位置是相对**地图容器**（.route-map，position:relative）算的；
 * 地图是 flex:1 动态高度，所以贴边请用 top/bottom 而不是写死的像素值。
 */
.legend{position:absolute;left:18rpx;top:18rpx;bottom:auto;right:auto;background:#ffffffdd;border-radius:14rpx;padding:14rpx 18rpx;max-width:330rpx}
.legend-title{font-size:20rpx;color:#2c4a3f;margin-bottom:8rpx}
.legend-bar{height:14rpx;border-radius:7rpx;background:linear-gradient(90deg,#ffe648,#ff9d27,#d12626,#8f142c)}
.legend-scale{display:flex;justify-content:space-between;font-size:18rpx;color:#718178;margin-top:4rpx}
.legend-item{display:flex;align-items:center;margin-top:10rpx}
.legend-item text{font-size:19rpx;color:#718178}
.legend-dash{width:48rpx;height:0;border-top:4rpx dashed #3a3a3a;margin-right:10rpx}
.legend-node{width:20rpx;height:20rpx;border-radius:50%;background:#e8720c;border:3rpx solid #fff;margin-right:10rpx}
/* 路线按拥堵叠色的小图例：三个小色块 + 文字，一行放得下（图例本来就窄） */
.legend-route-key{margin-top:12rpx}
.legend-key-label{font-size:19rpx;color:#2c4a3f;margin-right:8rpx}
.legend-swatch{width:26rpx;height:8rpx;border-radius:4rpx;margin:0 6rpx 0 10rpx}
.sw-ok{background:#146b55}
.sw-warn{background:#ef9d1f}
.sw-bad{background:#e0473a}

/* 目的地搜索面板 */
.sheet-tall{max-height:80vh;display:flex;flex-direction:column}
.kindbar{display:flex;gap:12rpx;margin-top:18rpx}
.kind{font-size:23rpx;color:#167052;background:#f2f8f4;border:2rpx solid #c9ddd0;border-radius:24rpx;padding:8rpx 24rpx}
.kind-on{background:#167052;color:#fff;border-color:#167052}
.place-list{max-height:52vh;margin-top:16rpx}
.place-row{display:flex;align-items:center;justify-content:space-between;padding:20rpx 4rpx;border-bottom:2rpx solid #eef3ef}
.place-main{flex:1}
.place-name{font-size:27rpx;color:#1c3b31}
.place-meta{font-size:21rpx;color:#718178;margin-top:6rpx}
.place-go{font-size:23rpx;color:#167052;border:2rpx solid #c9ddd0;border-radius:12rpx;padding:8rpx 20rpx}
.empty{font-size:24rpx;color:#8a9a92;text-align:center;padding:50rpx 0}
.pick-actions{display:flex;gap:14rpx;margin-top:18rpx}

/* 拥堵节点趣味提示 */
.joke{position:fixed;left:50rpx;right:50rpx;top:50%;transform:translateY(-50%);z-index:22;background:#fff;border-radius:26rpx;padding:36rpx 32rpx;box-shadow:0 20rpx 60rpx rgba(24,58,40,.25)}
.joke-tag{display:inline-block;font-size:20rpx;color:#8a4b00;background:#fff0d6;border-radius:20rpx;padding:4rpx 16rpx}
.joke-title{font-size:36rpx;font-weight:700;color:#146b55;margin-top:16rpx}
.joke-road{font-size:22rpx;color:#718178;margin-top:10rpx}
.joke-desc{font-size:26rpx;color:#2c4a3f;line-height:1.7;margin-top:18rpx}
.joke-options{margin-top:24rpx}
.joke-btn{font-size:28rpx;color:#167052;background:#e6f2ec;border-radius:16rpx;padding:22rpx;text-align:center;margin-top:14rpx}
.joke-note{font-size:20rpx;color:#93a29a;text-align:center;margin-top:20rpx}
.joke-close{font-size:26rpx;color:#718178;text-align:center;margin-top:10rpx;padding:12rpx}

/* 上报分类面板 */
.sheet-mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.35);z-index:20}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;background:#fff;border-radius:28rpx 28rpx 0 0;padding:32rpx 28rpx 40rpx}
.sheet-head{margin-bottom:22rpx}
.sheet-title{font-size:32rpx;font-weight:700;color:#146b55}
.sheet-loc{font-size:22rpx;color:#718178;margin-top:8rpx}
.sheet-cats{display:flex;flex-wrap:wrap;gap:14rpx}
.sheet-cat{width:calc(50% - 7rpx);box-sizing:border-box;border:2rpx solid #dbe8e1;border-radius:16rpx;padding:18rpx}
.sheet-cat-on{border-color:#167052;background:#e6f2ec}
.sheet-dot{width:44rpx;height:44rpx;line-height:44rpx;text-align:center;border-radius:50%;color:#fff;font-size:22rpx;font-weight:700}
.sheet-cat-name{font-size:26rpx;color:#1c3b31;margin-top:10rpx;font-weight:600}
.sheet-cat-hint{font-size:20rpx;color:#8a9a92;margin-top:4rpx}
.sheet-note{margin-top:22rpx;background:#f4f8f5;border-radius:14rpx;padding:20rpx;font-size:25rpx}
.sheet-actions{display:flex;gap:14rpx;margin-top:22rpx}
.sheet-actions .mini{flex:1;text-align:center}
.row-hint{font-size:22rpx;color:#718178;margin-top:8rpx}
.row-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}
.mini-wrap{flex:1;min-width:180rpx}
.mini{flex:1;min-width:180rpx;margin:0;padding:14rpx 8rpx;font-size:24rpx;line-height:1.4;color:#167052;background:#f2f8f4;border:2rpx solid #c9ddd0;border-radius:14rpx;text-align:center}
button.mini{margin:0;padding:14rpx 8rpx;font-size:24rpx;line-height:1.4;background:#f2f8f4;color:#167052;border:2rpx solid #c9ddd0;border-radius:14rpx}
button.mini::after{border:none}
.mini-active{background:#167052;color:#fff;border-color:#167052}
.mini-busy{opacity:.6}

/* 提示与错误 */
.error{margin-top:20rpx;font-size:24rpx;color:#b3261e;background:#fdecea;border-radius:12rpx;padding:18rpx;line-height:1.6}

/* 地图与点选 */
.route-map{position:relative;margin-top:34rpx;height:900rpx;background:#eef3ef;border-radius:18rpx;overflow:hidden}
.pick-banner{position:absolute;left:20rpx;right:20rpx;top:20rpx;z-index:5;background:#167052;color:#fff;font-size:24rpx;line-height:1.5;padding:16rpx 20rpx;border-radius:12rpx;text-align:center}
.route-zoom{position:absolute;left:0;top:0;right:0;bottom:0;transform-origin:center center}
.route-zoom .map-img{position:absolute;left:0;top:0;right:0;bottom:0}
.route-canvas{position:absolute;left:0;top:0;right:0;bottom:0;width:100%;height:100%}
.zoom-tools{position:absolute;right:18rpx;bottom:18rpx;display:flex;align-items:center;gap:8rpx;background:#ffffffdd;border-radius:14rpx;padding:8rpx}
.zoom-tools button{min-width:62rpx;height:58rpx;line-height:58rpx;padding:0;color:#167052;background:#fff;border:1rpx solid #b9d8c5;border-radius:10rpx;font-size:28rpx}
.zoom-tools button::after{border:none}
.zoom-tools text{min-width:64rpx;text-align:center;color:#167052;font-size:24rpx}
/* 全览时的提示：地图四周没有余量，拖不动是正常的，得让用户知道 */
.pan-hint{position:absolute;right:18rpx;bottom:96rpx;background:#ffffffdd;border-radius:12rpx;padding:6rpx 14rpx;font-size:19rpx;color:#4c6b5f}

/* 三种走法对比表 */
.cmp{margin-top:26rpx;background:#f2f8f4;border-radius:14rpx;padding:22rpx}
.cmp-title{font-size:26rpx;font-weight:600;color:#146b55;margin-bottom:12rpx}
.cmp-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 16rpx;border-radius:12rpx;background:#fff;margin-top:10rpx;border:2rpx solid transparent}
.cmp-active{border-color:#167052;background:#e6f2ec}
.cmp-name{font-size:26rpx;color:#1c3b31;font-weight:600}
.cmp-now{margin-left:12rpx;font-size:19rpx;font-weight:400;color:#fff;background:#167052;border-radius:16rpx;padding:3rpx 12rpx}
.cmp-nums{display:flex;flex-direction:column;align-items:flex-end}
.cmp-nums text{font-size:21rpx;color:#718178;line-height:1.5}
.cmp-nums .cmp-time{font-size:26rpx;color:#167052;font-weight:700}
.cmp-insight{margin-top:18rpx;font-size:24rpx;line-height:1.7;color:#2c4a3f;background:#fff;border-radius:12rpx;padding:18rpx}

/* ================= 一屏不滚动布局 =================
   页面整体 flex 纵向排布：顶部 → 状态 → 地图(flex:1) → 结果一行 → 主操作 → 模块网格。
   地图吃掉剩余空间，其余都是固定高度，所以任何机型都恰好一屏，不需要上下滑动找模块。
   .page.rt-page 用复合选择器压过 app.wxss 里的 .page（同权重时页面 wxss 更晚，但复合更稳）。 */
.page.rt-page{height:100vh;min-height:0;overflow:hidden;display:flex;flex-direction:column;padding:0 20rpx 14rpx;box-sizing:border-box}

.rt-top{display:flex;align-items:center;height:74rpx;flex:0 0 auto}
.rt-back{font-size:26rpx;color:#167052;padding-right:18rpx}
.rt-title{font-size:32rpx;font-weight:700;color:#146b55}

/* 状态条：当前条件的四个关键项，点哪一项进哪个模块。
   允许换行（而不是限宽截断），这样长口径（如「整周最高峰（包络）」）也完整可见；
   万一换行，地图会自己少占一点高度，仍然是一屏。 */
.rt-status{display:flex;flex-wrap:wrap;gap:8rpx;flex:0 0 auto;margin-bottom:10rpx}
.rt-chip{font-size:21rpx;color:#167052;background:#e6f2ec;border-radius:20rpx;padding:8rpx 16rpx;white-space:nowrap}
.rt-chip-on{color:#8a4b00;background:#fff0d6}

/* 地图主区：吃掉剩余高度 */
.route-map.rt-map{flex:1 1 auto;min-height:300rpx;height:auto;margin-top:0}

/* 结果摘要一行 */
.rt-result{flex:0 0 auto;display:flex;align-items:baseline;justify-content:space-between;gap:12rpx;margin-top:10rpx;padding:14rpx 20rpx;background:#e6f2ec;border-radius:14rpx}
.rt-result-empty{background:#f1f4f2}
.rt-result-main{font-size:26rpx;font-weight:600;color:#146b55;flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.rt-result-sub{font-size:21rpx;color:#61736a;white-space:nowrap}

/* 起点 / 终点：两个大按钮，点击弹选择方式 */
.rt-picks{display:flex;gap:12rpx;flex:0 0 auto;margin-top:10rpx}
.rt-pick{flex:1;min-width:0;display:flex;align-items:center;gap:10rpx;background:#fff;border:2rpx solid #e2e9e5;border-radius:14rpx;padding:14rpx 16rpx}
.rt-dot{width:16rpx;height:16rpx;border-radius:50%;flex:0 0 auto}
.rt-pick-text{flex:1;min-width:0;font-size:24rpx;color:#1d3b31;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.rt-pick-go{font-size:26rpx;color:#9bb0a6}

/* 走法 + 规划 */
.rt-actions{display:flex;gap:10rpx;flex:0 0 auto;margin-top:10rpx}
.rt-mode{flex:1;text-align:center;font-size:23rpx;color:#4c6b5f;background:#f2f8f4;border:2rpx solid #dbe8e1;border-radius:14rpx;padding:16rpx 0}
.rt-mode-on{background:#167052;color:#fff;border-color:#167052;font-weight:600}
.rt-plan{flex:1.6;margin:0;padding:0;line-height:2.4;font-size:27rpx;font-weight:600;color:#fff;background:#167052;border:0;border-radius:14rpx}
.rt-plan::after{border:none}

/* 模块按钮网格：3 列 × 3 行，9 个模块入口。
   按钮内部两行：图标+名称 / 角标。角标走正常文档流（不再绝对定位），
   所以长角标会自动截断，既不会压住名称，也不需要手调位置。 */
.rt-grid{flex:0 0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:10rpx}
.rt-cell{display:flex;flex-direction:column;justify-content:center;gap:4rpx;background:#fff;border:2rpx solid #e6ece8;border-radius:14rpx;padding:12rpx;min-width:0}
.rt-cell-top{display:flex;align-items:center;gap:6rpx;min-width:0}
.rt-cell-icon{font-size:24rpx;flex:0 0 auto}
.rt-cell-name{font-size:21rpx;color:#2c4a3f;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.rt-cell-badge{align-self:flex-start;max-width:100%;font-size:18rpx;color:#167082;background:#e6f2ec;border-radius:10rpx;padding:1rpx 8rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}

/* 按压反馈（hover-class） */
.tap-hover{opacity:.68}

