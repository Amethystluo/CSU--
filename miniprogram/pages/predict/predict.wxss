.is3d .map-img{transform:perspective(900px) rotateX(20deg) scale(1.18);transform-origin:center 65%;transition:transform .3s}.three-note{position:absolute;right:20rpx;top:20rpx;background:#ffffffdd;padding:16rpx;border-radius:12rpx;color:#167052;font-size:24rpx}.three-note text{font-size:20rpx;color:#687a70}
.road-row{display:flex;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #e4eee8}.road-row:last-child{border-bottom:0}.road-rank{width:48rpx;height:48rpx;line-height:48rpx;text-align:center;border-radius:50%;background:#e6f2ec;color:#167052;font-weight:700}.road-main{margin-left:18rpx;flex:1;font-size:27rpx}.road-main text{display:block;margin-top:8rpx;font-size:22rpx;color:#718178}
