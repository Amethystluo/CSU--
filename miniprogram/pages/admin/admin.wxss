.row-head{display:flex;align-items:center;margin-bottom:14rpx;flex-wrap:wrap}
.row-title{font-size:28rpx;font-weight:600;color:#146b55}
.badge{margin-left:14rpx;font-size:20rpx;color:#167052;background:#e6f2ec;border-radius:20rpx;padding:4rpx 14rpx}
.badge-warn{color:#8a4b00;background:#fff0d6}
.row-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}
.mini-wrap{flex:1;min-width:200rpx;margin-top:16rpx}
.mini{flex:1;min-width:200rpx;margin:0;padding:14rpx 8rpx;font-size:24rpx;line-height:1.4;color:#167052;background:#f2f8f4;border:2rpx solid #c9ddd0;border-radius:14rpx;text-align:center}
button.mini{margin:0;padding:14rpx 8rpx;font-size:24rpx;line-height:1.4;background:#f2f8f4;color:#167052;border:2rpx solid #c9ddd0;border-radius:14rpx}
button.mini::after{border:none}

/* 生效路况 */
.eff{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}
.eff-item{display:flex;align-items:center;background:#f4f4f4;border-radius:10rpx;padding:8rpx 14rpx}
.eff-kind{font-size:20rpx;color:#fff;background:#5a6b63;border-radius:8rpx;padding:3rpx 10rpx;margin-right:10rpx}
.eff-name{font-size:21rpx;color:#4a5a53}

/* 上报条目 */
.empty{font-size:24rpx;color:#8a9a92;text-align:center;padding:40rpx 0}
.rep{border:2rpx solid #e4eee8;border-radius:14rpx;padding:20rpx;margin-top:18rpx}
.rep-top{display:flex;align-items:center}
.rep-cat{font-size:21rpx;color:#fff;border-radius:10rpx;padding:5rpx 14rpx}
.rep-status{margin-left:12rpx;font-size:20rpx;border-radius:10rpx;padding:5rpx 14rpx}
.status-pending{color:#8a4b00;background:#fff0d6}
.status-verified{color:#146b55;background:#e6f2ec}
.status-rejected{color:#8a8a8a;background:#efefef}
.rep-time{margin-left:auto;font-size:20rpx;color:#93a29a}
.rep-body{display:flex;flex-direction:column;margin-top:14rpx}
.rep-road{font-size:25rpx;color:#1c3b31}
.rep-sub{font-size:21rpx;color:#718178;margin-top:6rpx}
.rep-note{font-size:22rpx;color:#4a5a53;margin-top:8rpx}
.rep-actions{display:flex;gap:12rpx;margin-top:16rpx}
.rep-btn{flex:1;text-align:center;font-size:23rpx;border-radius:12rpx;padding:14rpx 0}
.rep-btn.ok{color:#fff;background:#167052}
.rep-btn.no{color:#8a4b00;background:#fff0d6}
.rep-btn.del{color:#b3261e;background:#fdecea}
