/* ===== 吐槽主题头 ===== */
.cpl-hero{background:linear-gradient(135deg,#e07a1f,#f0a24d 60%,#ffc266);color:#fff;border-radius:24rpx;padding:34rpx 32rpx;margin-bottom:18rpx;position:relative;overflow:hidden}
.cpl-hero::after{content:'';position:absolute;right:-40rpx;top:-50rpx;width:200rpx;height:200rpx;border-radius:50%;background:rgba(255,255,255,.12)}
.cpl-hero::before{content:'';position:absolute;right:70rpx;bottom:-80rpx;width:150rpx;height:150rpx;border-radius:50%;background:rgba(255,255,255,.08)}
.cpl-hero-title{font-size:40rpx;font-weight:800;letter-spacing:2rpx;position:relative;z-index:1}
.cpl-hero-sub{font-size:24rpx;opacity:.94;margin-top:12rpx;line-height:1.6;position:relative;z-index:1}
.input-box{width:100%;min-height:160rpx;padding:20rpx;box-sizing:border-box;border:2rpx solid #c9ddd0;border-radius:14rpx;font-size:28rpx;line-height:1.6;background:#fafcfa;color:#183744}.input-footer{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx}.char-count{font-size:22rpx;color:#8a9e92}.submit-btn{background:#167052;color:#fff;border:0;border-radius:14rpx;font-size:28rpx;padding:16rpx 36rpx}.submit-btn[disabled]{background:#a3bfaf;color:#d9e6dd}.sort-bar{display:flex;align-items:center;gap:16rpx;margin:16rpx 0 8rpx;font-size:26rpx;color:#6c7d75}.sort-active{color:#167052;font-weight:600}.sort-divider{color:#c9ddd0}.empty-tip{padding:80rpx 0;text-align:center;font-size:28rpx;color:#8a9e92}.complaint-card{padding:28rpx 30rpx}.complaint-content{font-size:28rpx;line-height:1.7;color:#183744;word-break:break-all}.complaint-meta{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;flex-wrap:wrap;gap:8rpx}.complaint-time{font-size:22rpx;color:#8a9e92}.complaint-actions{display:flex;align-items:center;gap:6rpx}.action-btn{font-size:22rpx;color:#6c7d75;padding:8rpx 14rpx;background:#f2f8f4;border-radius:10rpx}.like-btn.liked{color:#e53935;background:#fde8e8}.delete-btn{color:#b55a5a}
